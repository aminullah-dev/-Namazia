<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>fa</string>

	<key>CFBundleDisplayName</key>
	<string>اوقات نماز</string>

	<key>CFBundleName</key>
	<string>Namazia</string>

	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>

	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<!-- Declaring Persian first makes iOS treat the app as an RTL app: system
	     controls, alerts and the share sheet all mirror to match our own UI. Both
	     entries have a matching .lproj in Localization/ — listing a language without
	     one makes the App Store advertise a translation that does not exist. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>fa</string>
		<string>ps</string>
	</array>

	<!-- Every font must be listed here or it silently fails to load at runtime and
	     SwiftUI quietly falls back to the system face. -->
	<key>UIAppFonts</key>
	<array>
		<string>Vazirmatn-Light.ttf</string>
		<string>Vazirmatn-Regular.ttf</string>
		<string>Vazirmatn-Medium.ttf</string>
		<string>Vazirmatn-Bold.ttf</string>
	</array>

	<!-- iOS can only sound an azan that was scheduled in advance, and it caps the
	     queue at 64 pending notifications — about six days of prayers. Background
	     refresh lets the system top that queue up while the app is closed, so the
	     azan does not quietly stop for someone who has not opened the app all week. -->
	<!-- Only the compass needs this, and only to rotate the qibla dial. The direction
	     itself is computed from the city the user picked, so refusing this leaves the
	     screen working. Nothing about the location ever leaves the phone. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>برای چرخاندن عقربه‌ی قبله به جهت درست، به قطب‌نمای گوشی نیاز است. هیچ اطلاعاتی از موقعیت شما ذخیره یا ارسال نمی‌شود.</string>

	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<!-- The full azan runs three to five minutes. Without this, locking the phone
		     or switching apps cuts it off mid-call. It only ever plays audio the user
		     started or a prayer time triggered — never silently in the background. -->
		<string>audio</string>
	</array>

	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>af.namazia.app.refresh</string>
	</array>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<!-- Portrait only: the qibla compass and the countdown ring are both designed
		     around a single vertical column, and landscape adds nothing here. -->
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>

	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
